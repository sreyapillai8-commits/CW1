    "### D11. Load objects from a file\n",
    "\n",
    "`records_sample.txt` (in this `LAB` folder) has one record per line, like `R-001,87,100`.\n",
    "\n",
    "1. Write `load_records(path)` that reads the file and returns a list of `Record` objects\n",
    "   (convert `value` and `limit` with `float()`).\n",
    "2. Loop over the list and print each record's label and status.\n",
    "\n",
    "**Expected output:** the same three lines as D9."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "dc2dce4e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "R-001 OK\n",
      "R-002 OVERLIMIT\n",
      "R-003 OK\n"
     ]
    }
   ],
   "source": [
    "# D11\n",
    "class Record:\n",
    "    def __init__(self, label, value, limit):\n",
    "        self.label = label\n",
    "        self.value = value\n",
    "        self.limit = limit\n",
    "\n",
    "    def status(self):\n",
    "        a = (self.value / self.limit) * 100\n",
    "        if a >= 100:\n",
    "            return \"OVERLIMIT\"\n",
    "        elif a >= 90:\n",
    "            return \"WARNING\"\n",
    "        else:\n",
    "            return \"OK\"\n",
    "\n",
    "def load_records(path):\n",
    "    records = []\n",
    "    with open(path, \"r\") as file:\n",
    "        for line in file:\n",
    "            line = line.strip()\n",
    "            if line:  # Skip empty lines if any\n",
    "                label, value, limit = line.split(\",\")\n",
    "                records.append(Record(label, float(value), float(limit)))   #convert value and limit with float() as specified\n",
    "    return records\n",
    "\n",
    "records_list = load_records(\"records_sample.txt\")  #load the records from the file\n",
    "for i in records_list:\n",
